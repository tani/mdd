{
  "name": "rat",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "prepare": "git config --local core.hooksPath .githooks && chmod +x .githooks/pre-commit",
    "lint": "eslint .",
    "format": "oxfmt --write \"packages/**/*.ts\" \"*.ts\"",
    "format:check": "oxfmt --check \"packages/**/*.ts\" \"*.ts\"",
    "test:vim": "bun test vim/rat_vim.test.ts",
    "compile": "bun run build.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@rat/markdown-unicode": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "latest",
    "@types/mdast": "^4.0.4",
    "@types/unist": "^3.0.3",
    "eslint": "^10.3.0",
    "eslint-plugin-no-type-assertion": "^1.3.0",
    "oxfmt": "^0.49.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.3"
  }
}
